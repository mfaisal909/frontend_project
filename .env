# Stripe publishable key used by the browser.
# Use a pk_test_... key for local development (http://localhost).
# A pk_live_... key only works when the app is served over HTTPS.
VITE_STRIPE_PUBLIC_KEY="pk_test_51UJpAxFoPvVUwmAJdVhYbI5nwQkaSZSqdk7L3hXek8gO31iuXnmfTp0zzDrh2Tzjdz3sFgZo7CuSKVqLQFaXgqYf00r9A4a4hy"

# Leave this false. VITE_DEV_HTTPS=true starts @vitejs/plugin-basic-ssl, whose
# self-signed certificate is not in the Windows trust store, so Chrome shows
# "Your connection is not private / net::ERR_CERT_AUTHORITY_INVALID" on every
# page load. https is only required for a pk_live_ Stripe key; a pk_test_ key
# works on http://localhost because browsers treat localhost as a secure origin.
# If you must use a pk_live_ key locally, set this to true AND install the
# generated cert (frontend/node_modules/.vite/deps-cert) into Trusted Root
# Certification Authorities instead of clicking through the warning.
VITE_DEV_HTTPS=false
